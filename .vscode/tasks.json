{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "FPGA: Lint (Verilator)",
      "type": "shell",
      "command": "${workspaceFolder}/../vscode-fpga/tools/vmake",
      "args": [
        "${fileDirname}",
        "lint"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        {
          "owner": "verilator",
          "fileLocation": "absolute",
          "pattern": {
            "regexp": "^%(Warning|Error)(?:-[A-Z0-9_]+)?: (/[^:]+):(\\d+):(\\d+): (.*)$",
            "severity": 1,
            "file": 2,
            "line": 3,
            "column": 4,
            "message": 5
          }
        }
      ],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      }
    },
    {
      "label": "FPGA: Lint design + testbench",
      "type": "shell",
      "command": "${workspaceFolder}/../vscode-fpga/tools/vmake",
      "args": [
        "${fileDirname}",
        "lint-tb"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        {
          "owner": "verilator",
          "fileLocation": "absolute",
          "pattern": {
            "regexp": "^%(Warning|Error)(?:-[A-Z0-9_]+)?: (/[^:]+):(\\d+):(\\d+): (.*)$",
            "severity": 1,
            "file": 2,
            "line": 3,
            "column": 4,
            "message": 5
          }
        }
      ],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      }
    },
    {
      "label": "FPGA: Simulate (Icarus)",
      "type": "shell",
      "command": "${workspaceFolder}/../vscode-fpga/tools/vmake",
      "args": [
        "${fileDirname}",
        "sim"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        {
          "owner": "iverilog",
          "fileLocation": "absolute",
          "severity": "error",
          "pattern": {
            "regexp": "^(/[^:]+):(\\d+): (?!\\$finish)(?:(error|warning|sorry): )?(.*)$",
            "file": 1,
            "line": 2,
            "severity": 3,
            "message": 4
          }
        }
      ],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "group": {
        "kind": "test",
        "isDefault": true
      }
    },
    {
      "label": "FPGA: Simulate other testbench (Icarus)",
      "type": "shell",
      "command": "${workspaceFolder}/../vscode-fpga/tools/vmake",
      "args": [
        "${fileDirname}",
        "sim",
        "TB=${input:tbName}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        {
          "owner": "iverilog",
          "fileLocation": "absolute",
          "severity": "error",
          "pattern": {
            "regexp": "^(/[^:]+):(\\d+): (?!\\$finish)(?:(error|warning|sorry): )?(.*)$",
            "file": 1,
            "line": 2,
            "severity": 3,
            "message": 4
          }
        }
      ],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      }
    },
