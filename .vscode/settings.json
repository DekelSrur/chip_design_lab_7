{
  "files.associations": {
    "*.v": "verilog",
    "*.vh": "verilog",
    "*.sv": "systemverilog",
    "*.svh": "systemverilog",
    "*.xdc": "tcl"
  },
  "files.exclude": {
    "**/.Xil": true,
    "**/xsim.dir": true
  },
  "[verilog]": {
    "editor.tabSize": 4,
    "editor.insertSpaces": true
  },
  "[systemverilog]": {
    "editor.tabSize": 4,
    "editor.insertSpaces": true
  },
  "verilog.linting.linter": "verilator",
  "verilog.linting.path": "/opt/homebrew/bin/",
  "verilog.linting.verilator.runAtFileLocation": true,
  "verilog.linting.verilator.arguments": "-Wall -Wno-fatal -Wno-DECLFILENAME --timing -y . -y ../src ../src/pkg_sys.sv ../src/pkg_rgf.sv ../src/rgf_bus_if.sv",
  "terminal.integrated.env.osx": {
    "PATH": "/opt/homebrew/bin:/usr/local/bin:${env:PATH}",
  "verilog.linting.path": "/opt/homebrew/bin/",
  }
}